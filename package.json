{
  "name": "poe2-skill-tree-optimizer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prepare-data": "node scripts/prepare-data.mjs",
    "predev": "npm run prepare-data",
    "dev": "vite",
    "prebuild": "npm run prepare-data",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "pretest": "node scripts/prepare-data.mjs --graph-only",
    "test": "vitest run",
    "pretest:node": "node scripts/prepare-data.mjs --graph-only",
    "test:node": "vitest run --project node",
    "pretest:dom": "node scripts/prepare-data.mjs --graph-only",
    "test:dom": "vitest run --project dom",
    "validate:quick": "node tools/validation/run.mjs quick",
    "validate:release": "node tools/validation/run.mjs release",
    "coverage:report": "tsx tools/coverage/cli.ts report",
    "coverage:check": "tsx tools/coverage/cli.ts check",
    "coverage:baseline": "tsx tools/coverage/cli.ts baseline",
    "coverage:refresh-catalog": "tsx tools/coverage/refresh-catalog.ts",
    "pretest:watch": "node scripts/prepare-data.mjs --graph-only",
    "test:watch": "vitest",
    "audit:pob": "node tools/pob-evaluation/run_audit.mjs",
    "extract:inventory": "tsx src/extract/cli.ts inventory",
    "extract:graph": "tsx src/extract/cli.ts graph",
    "extract:icons": "tsx src/extract/cli.ts icons",
    "prevalidate:graph": "node scripts/prepare-data.mjs --graph-only",
    "validate:graph": "tsx src/extract/cli.ts validate --graph public/tree-graph.json"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.20",
    "@vitejs/plugin-react": "latest",
    "fflate": "^0.8.3",
    "lucide-react": "^1.72.0",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "jsdom": "latest",
    "tsx": "latest",
    "vitest": "latest"
  }
}
